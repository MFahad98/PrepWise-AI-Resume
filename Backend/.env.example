# MongoDB Atlas connection string (database name "resume" automatically use hota hai)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# Optional: database ka naam badalna ho to (default: resume)
# MONGO_DB_NAME=resume

# Strong random secret (e.g. 64 characters)
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini API key
GOOGLE_GENAI_API_KEY=your-gemini-api-key

# Frontend URL(s) jinko backend allow karega (comma separated, no trailing slash)
CLIENT_URL=https://your-frontend.vercel.app

# Local only
PORT=3000
